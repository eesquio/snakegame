rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leaderboard for "Seguir Cursor (360)" mode
    match /leaderboard_follow/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow delete: if false;
    }

    // Leaderboard for "Cursor Direto" mode
    match /leaderboard_direct/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow delete: if false;
    }

    // Legacy fallback
    match /leaderboard/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.nickname is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow delete: if false;
    }
  }
}
